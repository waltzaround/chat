# Copy to .dev.vars for local development. Never commit .dev.vars.
# In production set each of these with `wrangler secret put <NAME>`.

# Better Auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# OAuth providers (optional locally; the buttons are hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Turnstile secret. The matching public site key lives in wrangler.jsonc `vars`.
# 1x0000000000000000000000000000000AA is Cloudflare's "always passes" test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare RealtimeKit (voice/video). Required for voice rooms to work.
CLOUDFLARE_ACCOUNT_ID=
REALTIMEKIT_APP_ID=
CLOUDFLARE_REALTIME_API_TOKEN=

# R2 S3-compatible credentials used to presign direct-to-bucket upload URLs.
# Create an R2 API token with Object Read & Write on the commons-uploads bucket.
# When unset locally, uploads fall back to a Worker-proxied PUT (dev only).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
