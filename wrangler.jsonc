{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // API and WebSocket routes always hit the Worker, everything else is served as a static asset
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "observability": { "enabled": true },
  // Hourly maintenance: expire invites and remove uploads that were never attached to a message.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    // Public, non-secret configuration. Secrets live in .dev.vars / `wrangler secret put`.
    // Optional. Blank uses whatever origin the request arrived on (localhost in dev,
    // your workers.dev URL or custom domain in production). Set it to pin one origin.
    "APP_URL": "",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "R2_BUCKET_NAME": "chat-uploads",
    // Optional. Sender for password-reset email, e.g. "chat@example.com". Email needs the
    // Workers Paid plan, a domain on Cloudflare DNS, and the send_email binding that
    // `npm run setup` adds when you choose it. Blank keeps email off.
    "EMAIL_FROM": "",
    "REALTIMEKIT_PRESET_FULL": "chat_full",
    "REALTIMEKIT_PRESET_LISTEN": "chat_listen"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat",
      // Leave empty in git. Deploy to Cloudflare creates the database in the
      // deployer's account and writes the id into their clone. A real id
      // committed here would point every deploy at one shared database.
      "database_id": "",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "chat-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_HUB",
        "class_name": "WorkspaceHub"
      },
      {
        "name": "USER_HUB",
        "class_name": "UserHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserHub"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BACKGROUND_QUEUE",
        "queue": "chat-background"
      }
    ],
    "consumers": [
      {
        "queue": "chat-background",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "chat_events"
    }
  ]
}
