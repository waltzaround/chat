{
  // The push relay for the Chat iOS and Android apps. Whoever publishes the apps runs
  // one (it holds the Apple and Firebase keys); every Chat server sends through it.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chat-push-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // The iOS app's bundle id, and "1" while testing with development builds.
    "APNS_TOPIC": "chat.beacon.ios",
    "APNS_SANDBOX": "0"
  }
  // Secrets (wrangler secret put …):
  //   RELAY_KEY            32 random bytes, base64 (openssl rand -base64 32)
  //   APNS_KEY             the .p8 key from Apple (Certificates, IDs & Profiles > Keys)
  //   APNS_KEY_ID          its Key ID
  //   APNS_TEAM_ID         your Apple team ID
  //   FCM_SERVICE_ACCOUNT  the Firebase service account JSON
}
