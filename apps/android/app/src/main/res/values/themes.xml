<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, like Discord. Compose draws everything; this only sets the window. -->
    <style name="Theme.Chat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rail</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
