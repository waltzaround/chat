{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The project website at chat.walt.online: static files from `npm run website:build`.
  "name": "chat-website",
  "compatibility_date": "2026-09-29",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "chat.walt.online", "custom_domain": true }]
}
