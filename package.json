{
  "name": "chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx db/seed.ts && wrangler d1 execute DB --local --file=db/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types worker/env.d.ts",
    "realtimekit:presets": "tsx scripts/realtimekit-presets.ts"
  },
  "dependencies": {
    "@cloudflare/realtimekit": "^2.0.2",
    "@cloudflare/realtimekit-react": "^2.0.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "uuidv7": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cloudflared": "^0.7.3",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.136.3"
  }
}
